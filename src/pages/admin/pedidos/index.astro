---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listOrders } from '../../../lib/repo/orders';
import { brl } from '../../../lib/format';
import { orderStatusLabel, PAYMENT_METHOD_LABELS } from '../../../lib/types';

export const prerender = false;

const orders = await listOrders(500);
const statusFilter = Astro.url.searchParams.get('status');
const filtered = statusFilter ? orders.filter((o) => o.status === statusFilter) : orders;

const tabs = [
  { key: null, label: 'Todos' },
  { key: 'pending', label: 'Pendentes' },
  { key: 'paid', label: 'Pagos' },
  { key: 'shipped', label: 'Enviados' },
  { key: 'delivered', label: 'Entregues' },
  { key: 'failed', label: 'Falhos' },
];
---

<AdminLayout title="Pedidos">
  <div class="flex gap-2">
    {tabs.map((t) => (
      <a
        href={t.key ? `/admin/pedidos?status=${t.key}` : '/admin/pedidos'}
        class:list={['rounded-full border px-3 py-1 font-sans text-[13px]', (statusFilter ?? null) === t.key ? 'border-ink bg-ink text-bone' : 'border-ink/20 text-ink-soft']}
      >
        {t.label}
      </a>
    ))}
  </div>

  <div class="mt-6 overflow-x-auto rounded-card border border-ink/10 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-ink/10 text-[12px] uppercase tracking-[0.1em] text-ink-muted">
        <tr>
          <th class="p-3">Pedido</th><th class="p-3">Data</th><th class="p-3">Cliente</th>
          <th class="p-3">Pagamento</th><th class="p-3">Status</th><th class="p-3 text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {filtered.length === 0 && (
          <tr><td colspan="6" class="p-6 text-center text-ink-muted">Nenhum pedido.</td></tr>
        )}
        {filtered.map((o) => (
          <tr class="border-t border-ink/10 hover:bg-bone-50">
            <td class="p-3">
              <a href={`/admin/pedidos/${o.order_number}`} class="text-agua-dark">{o.order_number}</a>
              {o.source === 'caixa' && (
                <span class="ml-2 rounded-full bg-blush-light px-1.5 py-0.5 text-[10px] uppercase tracking-[0.1em] text-ink-soft">Caixa</span>
              )}
            </td>
            <td class="p-3 text-ink-muted">{new Date(o.created_at).toLocaleDateString('pt-BR')}</td>
            <td class="p-3 text-ink-soft">{o.customer_name}<span class="block text-[12px] text-ink-muted">{o.customer_email}</span></td>
            <td class="p-3 text-ink-soft">{o.payment_method ? PAYMENT_METHOD_LABELS[o.payment_method] : '—'}</td>
            <td class="p-3"><span class="rounded-full bg-bone-200 px-2 py-0.5 text-[11px] uppercase">{orderStatusLabel(o.status, o.source)}</span></td>
            <td class="p-3 text-right">{brl(o.total_cents)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
