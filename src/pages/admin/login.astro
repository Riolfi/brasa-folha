---
import '../../styles/global.css';
import ThemeVars from '../../components/ThemeVars.astro';

export const prerender = false;

const err = Astro.url.searchParams.get('erro') === '1';
const next = Astro.url.searchParams.get('next') || '/admin';
const brandName = Astro.locals.brand.name;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeVars />
    <title>Entrar · Admin {brandName}</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-bone px-5">
    <div class="w-full max-w-sm">
      <a href="/" class="font-display text-2xl lowercase">{brandName}</a>
      <h1 class="mt-6 font-display text-2xl">Painel administrativo</h1>
      <p class="mt-1 font-sans text-[13px] text-ink-muted">Acesso restrito.</p>

      {err && (
        <p class="mt-4 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
          Senha incorreta.
        </p>
      )}

      <form method="POST" action="/api/admin/login" class="mt-6 space-y-4">
        <input type="hidden" name="next" value={next} />
        <div>
          <label class="label" for="password">Senha</label>
          <input id="password" name="password" type="password" class="field" required autofocus />
        </div>
        <button type="submit" class="btn-primary w-full">Entrar</button>
      </form>
    </div>
  </body>
</html>
