---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizFlow from '../../components/QuizFlow.tsx';
import WaveDivider from '../../components/WaveDivider.astro';
import { env } from '../../lib/env';

export const prerender = false;

if (!env.quizEnabled) return Astro.redirect('/');
---

<BaseLayout
  title="Teste de pele — monte sua rotina"
  description="Responda 7 perguntas rápidas e receba uma rotina de skincare AM/PM personalizada para o seu tipo de pele e seus objetivos."
>
  <section class="container-x py-12 md:py-16">
    <div id="rotina-intro">
      <div class="mx-auto max-w-xl text-center">
        <p class="eyebrow">Teste de pele</p>
        <h1 class="mt-4 font-display text-4xl leading-tight sm:text-5xl">
          Descubra a sua rotina em 2 minutos
        </h1>
        <p class="mt-4 font-sans text-[15px] leading-relaxed text-ink-soft">
          Sete perguntas sobre a sua pele e seus objetivos. No fim, montamos uma rotina de
          manhã e de noite — passo a passo, com o porquê de cada produto e o custo total.
        </p>
      </div>
    </div>

    <div class="mt-12">
      <QuizFlow client:load />
    </div>
  </section>

  <div id="rotina-intro-extra">
    <WaveDivider class="text-agua-wash" color="#E3ECE9" />
    <section class="bg-agua-wash py-14">
      <div class="container-x grid gap-8 text-center md:grid-cols-3">
        {[
          ['Sem achismo', 'A recomendação segue regras claras de tipo de pele, objetivo e compatibilidade de ativos.'],
          ['Seguro', 'Se você indicar gravidez, amamentação ou pele muito sensível, retiramos retinal e ácidos fortes.'],
          ['No seu ritmo', 'A rotina começa enxuta. Você adiciona passos conforme a pele se acostuma.'],
        ].map(([t, d]) => (
          <div>
            <h2 class="font-display text-lg">{t}</h2>
            <p class="mt-2 font-sans text-[14px] leading-relaxed text-ink-soft">{d}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
