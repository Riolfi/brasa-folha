---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoutineResultView from '../../components/RoutineResult.tsx';
import { getQuizByToken } from '../../lib/repo/quiz';
import { env } from '../../lib/env';

export const prerender = false;

if (!env.quizEnabled) return Astro.redirect('/');

const { token } = Astro.params;
const quiz = token ? await getQuizByToken(token) : null;
---

<BaseLayout title="Sua rotina" description="Rotina de skincare personalizada." noindex>
  <section class="container-x py-12 md:py-16">
    <h1 class="sr-only">Sua rotina de skincare personalizada</h1>
    {quiz ? (
      <RoutineResultView client:load result={quiz.result} />
    ) : (
      <div class="mx-auto max-w-md text-center">
        <h1 class="font-display text-3xl">Rotina não encontrada</h1>
        <p class="prose-iarah mx-auto mt-4">
          Esse link pode ter expirado. Faça o teste de novo para gerar a sua rotina.
        </p>
        <a href="/rotina" class="btn-primary mt-6">Fazer o teste</a>
      </div>
    )}
  </section>
</BaseLayout>
