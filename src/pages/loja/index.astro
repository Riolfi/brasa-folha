---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getCategories, getCategoryTree, getProducts, type SortKey } from '../../lib/repo/catalog';
import { env } from '../../lib/env';

export const prerender = false;

const url = Astro.url;
const categoriaParam = url.searchParams.get('categoria');
const sortParam = (url.searchParams.get('ordenar') || 'destaque') as SortKey;
const validSorts: SortKey[] = ['destaque', 'preco-asc', 'preco-desc', 'vendidos', 'novidades'];
const sort: SortKey = validSorts.includes(sortParam) ? sortParam : 'destaque';

const [categories, tree] = await Promise.all([getCategories(), getCategoryTree()]);
const activeCategory = categories.find((c) => c.slug === categoriaParam) ?? null;
const activeRoot = activeCategory
  ? activeCategory.parent_id
    ? categories.find((c) => c.id === activeCategory.parent_id) ?? null
    : activeCategory
  : null;
const subPills = activeRoot ? tree.find((r) => r.id === activeRoot.id)?.children ?? [] : [];

const products = await getProducts({
  categorySlug: activeCategory?.slug ?? null,
  sort,
});

const qs = (slug: string | null) => {
  const p = new URLSearchParams();
  if (slug) p.set('categoria', slug);
  if (sort !== 'destaque') p.set('ordenar', sort);
  const s = p.toString();
  return s ? `/loja?${s}` : '/loja';
};

const sortLabels: Record<SortKey, string> = {
  destaque: 'Em destaque',
  'preco-asc': 'Menor preço',
  'preco-desc': 'Maior preço',
  vendidos: 'Mais vendidos',
  novidades: 'Novidades',
};

const heading = activeCategory ? activeCategory.name : 'Todos os produtos';
const description = activeCategory
  ? activeCategory.description
  : `O catálogo completo da ${Astro.locals.brand.name}.`;

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Loja ${Astro.locals.brand.name} — ${heading}`,
  itemListElement: products.slice(0, 20).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${env.siteUrl}/produto/${p.slug}`,
    name: p.name,
  })),
};
---

<BaseLayout title={`${heading} · Loja`} description={description}>
  <StructuredData slot="head" data={itemListJsonLd} />

  <section class="container-x pb-16 pt-10 md:pt-14">
    <nav class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted" aria-label="Trilha">
      <a href="/" class="hover:text-ink">Início</a>
      <span class="mx-2">/</span>
      <a href="/loja" class="hover:text-ink">Loja</a>
      {activeRoot && activeRoot !== activeCategory && (<><span class="mx-2">/</span><a href={qs(activeRoot.slug)} class="hover:text-ink">{activeRoot.name}</a></>)}
      {activeCategory && (<><span class="mx-2">/</span><span class="text-ink">{activeCategory.name}</span></>)}
    </nav>

    <header class="mt-6 max-w-2xl">
      <h1 class="font-display text-4xl sm:text-5xl">{heading}</h1>
      <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft">{description}</p>
    </header>

    <div class="loja-filters mt-10 border-y border-ink/10 py-4">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-2" role="list">
          <a
            href={qs(null)}
            class:list={['rounded-full border px-4 py-1.5 font-sans text-[13px] transition-colors', !activeCategory ? 'border-ink bg-ink text-bone' : 'border-ink/20 text-ink-soft hover:border-ink']}
          >
            Tudo
          </a>
          {tree.map((root) => {
            const isActive = activeRoot?.id === root.id;
            return (
              <a
                href={qs(root.slug)}
                class:list={['rounded-full border px-4 py-1.5 font-sans text-[13px] transition-colors', isActive ? 'border-ink bg-ink text-bone' : 'border-ink/20 text-ink-soft hover:border-ink']}
              >
                {root.name}
              </a>
            );
          })}
        </div>

        <label class="flex items-center gap-2 font-sans text-[13px] text-ink-muted">
          <span class="whitespace-nowrap">Ordenar por</span>
          <select id="sort" class="field !w-auto !py-2 !text-[13px]">
            {validSorts.map((s) => (
              <option value={s} selected={s === sort}>{sortLabels[s]}</option>
            ))}
          </select>
        </label>
      </div>

      {subPills.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2" role="list">
          <a
            href={qs(activeRoot!.slug)}
            class:list={['rounded-full px-3 py-1 font-sans text-[12px] transition-colors', activeCategory?.id === activeRoot!.id ? 'bg-agua text-white' : 'bg-bone-200 text-ink-soft hover:bg-bone-300']}
          >
            Tudo de {activeRoot!.name}
          </a>
          {subPills.map((sub) => (
            <a
              href={qs(sub.slug)}
              class:list={['rounded-full px-3 py-1 font-sans text-[12px] transition-colors', activeCategory?.id === sub.id ? 'bg-agua text-white' : 'bg-bone-200 text-ink-soft hover:bg-bone-300']}
            >
              {sub.name}
            </a>
          ))}
        </div>
      )}
    </div>

    <p class="mt-4 font-sans text-[13px] text-ink-muted">{products.length} {products.length === 1 ? 'produto' : 'produtos'}</p>

    {products.length === 0 ? (
      <p class="mt-16 text-center font-sans text-ink-muted">Nada por aqui ainda. Volte em breve.</p>
    ) : (
      <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 lg:grid-cols-3 xl:grid-cols-4">
        {products.map((product, i) => (
          <ProductCard product={product} loading={i < 4 ? 'eager' : 'lazy'} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const select = document.getElementById('sort');
    if (!select) return;
    select.addEventListener('change', () => {
      const url = new URL(window.location.href);
      if (select.value === 'destaque') url.searchParams.delete('ordenar');
      else url.searchParams.set('ordenar', select.value);
      window.location.href = url.toString();
    });
  })();
</script>
