---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from '../lib/env';

export const prerender = false;

const sent = Astro.url.searchParams.get('enviado') === '1';
const { data: page } = Astro.locals.site.page_contato;
const { data: contact } = Astro.locals.site.contact;
const wpp = `https://wa.me/${contact.whatsapp_number || env.whatsappNumber}`;
---

<BaseLayout
  title="Contato"
  description={`Fale com a ${Astro.locals.brand.name} pelo WhatsApp, e-mail ou pelo formulário.`}
>
  <section class="container-x grid gap-12 py-14 md:grid-cols-2 md:gap-16 md:py-20">
    <div>
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1 class="mt-5 font-display text-4xl sm:text-5xl">{page.title}</h1>
      {page.intro && <p class="prose-iarah mt-5">{page.intro}</p>}

      <div class="mt-8 space-y-5">
        <div>
          <p class="font-sans text-[12px] uppercase tracking-[0.14em] text-ink-muted">WhatsApp</p>
          <a href={wpp} class="link-underline font-display text-lg text-ink">Abrir conversa</a>
        </div>
        {contact.email && (
          <div>
            <p class="font-sans text-[12px] uppercase tracking-[0.14em] text-ink-muted">E-mail</p>
            <a href={`mailto:${contact.email}`} class="link-underline font-display text-lg text-ink">{contact.email}</a>
          </div>
        )}
        {contact.hours && (
          <div>
            <p class="font-sans text-[12px] uppercase tracking-[0.14em] text-ink-muted">Horário</p>
            <p class="font-sans text-[15px] text-ink-soft">{contact.hours}</p>
          </div>
        )}
      </div>
    </div>

    {page.show_form && (
      <div>
        {sent && (
          <p class="mb-6 rounded-card border border-agua/40 bg-agua-wash px-4 py-3 text-sm text-agua-dark">
            Mensagem enviada. Obrigado — respondemos em breve.
          </p>
        )}
        <form method="POST" action="/api/contact" class="space-y-4">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div>
            <label class="label" for="name">Nome</label>
            <input id="name" name="name" class="field" required />
          </div>
          <div>
            <label class="label" for="email">E-mail</label>
            <input id="email" name="email" type="email" class="field" required />
          </div>
          <div>
            <label class="label" for="phone">Telefone (opcional)</label>
            <input id="phone" name="phone" class="field" />
          </div>
          <div>
            <label class="label" for="message">Mensagem</label>
            <textarea id="message" name="message" rows="5" class="field" required></textarea>
          </div>
          <button type="submit" class="btn-primary w-full sm:w-auto">Enviar mensagem</button>
          <p class="font-sans text-[12px] text-ink-muted">
            Ao enviar, você concorda com o uso dos seus dados para retorno do contato, conforme a
            <a href="/privacidade" class="underline">Política de Privacidade</a>.
          </p>
        </form>
      </div>
    )}
  </section>
</BaseLayout>
