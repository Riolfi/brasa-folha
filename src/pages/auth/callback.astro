---
import type { User } from '@supabase/supabase-js';
import { safeNextPath } from '../../lib/auth';
import { claimGuestOrders } from '../../lib/repo/orders';

export const prerender = false;

const url = Astro.url;
const sb = Astro.locals.supabase;
const code = url.searchParams.get('code');
const tokenHash = url.searchParams.get('token_hash');
const otpType = url.searchParams.get('type');

let user: User | null = null;

if (sb) {
  if (code) {
    const { data } = await sb.auth.exchangeCodeForSession(code);
    user = data.user ?? null;
  } else if (tokenHash && otpType) {
    const { data } = await sb.auth.verifyOtp({
      token_hash: tokenHash,
      type: otpType as 'email' | 'signup' | 'recovery' | 'invite' | 'magiclink',
    });
    user = data.user ?? null;
  }
}

if (user?.email) {
  await claimGuestOrders(user.email, user.id);
}

const dest = user
  ? safeNextPath(url.searchParams.get('next'), '/conta')
  : '/entrar?erro=callback';

return Astro.redirect(dest);
---
