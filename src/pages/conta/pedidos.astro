---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { listOrdersByUser } from '../../lib/repo/orders';
import { brl } from '../../lib/format';
import { ORDER_STATUS_LABELS } from '../../lib/types';

export const prerender = false;

const user = Astro.locals.user!;
const orders = await listOrdersByUser(user.id, 100);
---

<AccountLayout title="Meus pedidos" active="pedidos">
  {orders.length === 0 ? (
    <p class="prose-iarah">
      Nenhum pedido por aqui ainda. <a href="/loja" class="text-agua-dark underline">Ver a loja</a>.
    </p>
  ) : (
    <ul class="divide-y divide-ink/10 border-y border-ink/10">
      {orders.map((o) => (
        <li class="py-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <a href={`/conta/pedidos/${o.order_number}`} class="font-display text-lg text-ink hover:text-agua-dark">
              {o.order_number}
            </a>
            <span class="rounded-full bg-bone-200 px-2 py-0.5 text-[11px] uppercase">{ORDER_STATUS_LABELS[o.status]}</span>
          </div>
          <p class="mt-1 font-sans text-[13px] text-ink-muted">
            {new Date(o.created_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
          </p>
          <div class="mt-2 flex items-center justify-between">
            <p class="font-sans text-[13px] text-ink-soft">
              {o.items.map((i) => `${i.quantity}× ${i.product_name}`).join(' · ')}
            </p>
          </div>
          <p class="mt-1 font-sans text-sm">{brl(o.total_cents)}</p>
        </li>
      ))}
    </ul>
  )}
</AccountLayout>
