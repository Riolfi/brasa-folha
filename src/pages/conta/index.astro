---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { listOrdersByUser } from '../../lib/repo/orders';
import { getProfile } from '../../lib/repo/account';
import { brl } from '../../lib/format';
import { ORDER_STATUS_LABELS } from '../../lib/types';

export const prerender = false;

const user = Astro.locals.user!;
const sb = Astro.locals.supabase!;
const [orders, profile] = await Promise.all([
  listOrdersByUser(user.id, 5),
  getProfile(sb, user.id),
]);
const firstName = (profile.full_name || user.email || '').split(/\s+/)[0];
---

<AccountLayout title={firstName ? `Olá, ${firstName}` : 'Minha conta'} active="conta">
  <div class="grid gap-4 sm:grid-cols-3">
    <a href="/conta/pedidos" class="rounded-card border border-ink/10 bg-white/50 p-5 transition-colors hover:border-ink/30">
      <p class="font-display text-2xl">{orders.length}</p>
      <p class="mt-1 font-sans text-[13px] text-ink-muted">pedidos recentes</p>
    </a>
    <a href="/conta/perfil" class="rounded-card border border-ink/10 bg-white/50 p-5 transition-colors hover:border-ink/30">
      <p class="font-sans text-sm text-ink">Meus dados</p>
      <p class="mt-1 font-sans text-[13px] text-ink-muted">{profile.phone ? 'atualizados' : 'completar cadastro'}</p>
    </a>
    <a href="/conta/enderecos" class="rounded-card border border-ink/10 bg-white/50 p-5 transition-colors hover:border-ink/30">
      <p class="font-sans text-sm text-ink">Endereços</p>
      <p class="mt-1 font-sans text-[13px] text-ink-muted">gerenciar entregas</p>
    </a>
  </div>

  <h2 class="mt-10 font-display text-xl">Pedidos recentes</h2>
  {orders.length === 0 ? (
    <p class="prose-iarah mt-4">
      Você ainda não fez nenhum pedido. <a href="/loja" class="text-agua-dark underline">Ver a loja</a>.
    </p>
  ) : (
    <ul class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
      {orders.map((o) => (
        <li class="flex items-center justify-between gap-4 py-4">
          <div>
            <a href={`/conta/pedidos/${o.order_number}`} class="font-sans text-sm text-agua-dark">{o.order_number}</a>
            <p class="font-sans text-[12px] text-ink-muted">
              {new Date(o.created_at).toLocaleDateString('pt-BR')} · {o.items.length} {o.items.length === 1 ? 'item' : 'itens'}
            </p>
          </div>
          <div class="text-right">
            <span class="rounded-full bg-bone-200 px-2 py-0.5 text-[11px] uppercase">{ORDER_STATUS_LABELS[o.status]}</span>
            <p class="mt-1 font-sans text-sm">{brl(o.total_cents)}</p>
          </div>
        </li>
      ))}
    </ul>
  )}
</AccountLayout>
