---
/**
 * Emite as variáveis CSS da cor de acento (--agua-*) no <head>. Precisa estar
 * em TODO documento HTML independente — não só em BaseLayout, porque
 * AdminLayout e admin/login têm <html> próprio e também usam classes
 * `agua-*` (sem isso, ficam sem cor).
 */
import { theme } from '../lib/theme';
import { hexToRgbTriplet } from '../lib/color';

const a = theme.colors.agua;
const css = `:root{--agua-default:${hexToRgbTriplet(a.DEFAULT)};--agua-light:${hexToRgbTriplet(a.light)};--agua-dark:${hexToRgbTriplet(a.dark)};--agua-wash:${hexToRgbTriplet(a.wash)}}`;
---

<style is:global set:html={css} />
