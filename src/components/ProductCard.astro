---
import type { Product } from '../lib/types';
import PriceDisplay from './PriceDisplay.astro';
import ProductImage from './ProductImage.astro';
import FavoriteButton from './FavoriteButton.tsx';

interface Props {
  product: Product;
  loading?: 'lazy' | 'eager';
}
const { product, loading = 'lazy' } = Astro.props;
const hasDiscount =
  product.compare_at_price_cents != null && product.compare_at_price_cents > product.price_cents;
const soldOut = product.stock <= 0;
---

<div class="group relative">
  <FavoriteButton client:visible slug={product.slug} floating />
  <a href={`/produto/${product.slug}`} class="block">
    <div class="product-card__media relative overflow-hidden rounded-card bg-bone-200">
      <ProductImage
        src={product.images[0] ?? ''}
        alt={product.name}
        loading={loading}
        class="transition-transform duration-700 ease-smooth group-hover:scale-[1.04]"
      />
      {product.images[1] && (
        <ProductImage
          src={product.images[1]}
          alt=""
          loading="lazy"
          class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      )}
      <div class="absolute left-3 top-3 flex flex-col gap-1.5">
        {product.is_bestseller && (
          <span class="rounded-card bg-bone/90 px-2 py-1 font-sans text-[10px] uppercase tracking-[0.14em] text-ink">
            Mais vendido
          </span>
        )}
        {hasDiscount && !soldOut && (
          <span class="rounded-card bg-agua px-2 py-1 font-sans text-[10px] uppercase tracking-[0.14em] text-white">
            Oferta
          </span>
        )}
        {soldOut && (
          <span class="rounded-card bg-ink/80 px-2 py-1 font-sans text-[10px] uppercase tracking-[0.14em] text-bone">
            Esgotado
          </span>
        )}
      </div>
    </div>

    <div class="mt-4">
      <p class="font-sans text-[11px] uppercase tracking-[0.14em] text-ink-muted">{product.category_name}</p>
      <h3 class="mt-1 font-display text-lg leading-snug text-ink group-hover:text-agua-dark">
        {product.name}
      </h3>
      <p class="mt-1 line-clamp-2 font-sans text-[13px] leading-relaxed text-ink-muted">
        {product.short_description}
      </p>
      <div class="mt-2.5">
        <PriceDisplay
          priceCents={product.price_cents}
          compareAtCents={product.compare_at_price_cents}
          size="sm"
        />
      </div>
    </div>
  </a>
</div>
