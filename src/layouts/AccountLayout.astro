---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  active: 'conta' | 'pedidos' | 'perfil' | 'enderecos';
}
const { title, active } = Astro.props;

const nav = [
  { key: 'conta', href: '/conta', label: 'Visão geral' },
  { key: 'pedidos', href: '/conta/pedidos', label: 'Meus pedidos' },
  { key: 'perfil', href: '/conta/perfil', label: 'Meus dados' },
  { key: 'enderecos', href: '/conta/enderecos', label: 'Endereços' },
] as const;
---

<BaseLayout title={title} description="Área do cliente." noindex>
  <section class="container-x py-12 md:py-16">
    <p class="eyebrow">Minha conta</p>
    <h1 class="mt-3 font-display text-3xl sm:text-4xl">{title}</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-[200px_1fr] md:gap-14">
      <nav class="flex gap-1 overflow-x-auto md:flex-col" aria-label="Navegação da conta">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap rounded-card px-3 py-2 font-sans text-sm transition-colors',
              item.key === active ? 'bg-ink text-bone' : 'text-ink-soft hover:bg-bone-200',
            ]}
          >
            {item.label}
          </a>
        ))}
        <form method="POST" action="/auth/sair" class="md:mt-2">
          <button class="w-full whitespace-nowrap rounded-card px-3 py-2 text-left font-sans text-sm text-ink-muted hover:bg-bone-200 hover:text-ink">
            Sair
          </button>
        </form>
      </nav>

      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
