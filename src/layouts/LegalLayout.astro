---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="container-x max-w-3xl py-14 md:py-20">
    <h1 class="font-display text-4xl">{title}</h1>
    <p class="mt-3 font-sans text-[13px] text-ink-muted">Última atualização: {updated}</p>
    <div class="legal mt-10">
      <slot />
    </div>
  </section>
</BaseLayout>

<style is:global>
  .legal h2 { @apply mt-10 font-display text-xl text-ink; }
  .legal h3 { @apply mt-6 font-sans text-[15px] font-semibold text-ink; }
  .legal p, .legal li { @apply font-sans text-[14px] leading-relaxed text-ink-soft; }
  .legal p { @apply mt-3; }
  .legal ul { @apply mt-3 list-disc space-y-1.5 pl-5; }
  .legal a { @apply text-agua-dark underline; }
</style>
